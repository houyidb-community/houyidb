# 仅本仓库特有；通用规则见 ~/.gitignore_global（已配置 core.excludesfile）
storage/
.cursor/
target/
*.parquet
*.bin
.claude/
.DS_Store
.playwright-mcp/

# 官网静态站仅留在内部历史，CE 公共快照不导出
# EN: Site assets stay in internal history only; the CE public snapshot excludes them.
site/

# 知识产权材料与开发日志：不入公开仓库（前缀通配，防未来新文件漏网）
dev-log.md
docs/IP_*

# 品牌设计源文件（.ai/.zip 等）；如需展示仅提交导出图
docs/logo/

# .NET 构建产物（`bin/` 会误伤 Rust 的 src/bin，按目录显式豁免）
bin/
obj/
!**/src/bin/

# Java/Gradle 构建产物
.gradle/
build/

# 演练脚本共享库仅内部使用，CE 公共快照不导出
# EN: Shared drill-script library is internal-only and excluded from CE snapshots.
scripts/lib/

# 本地推广/汇报材料与内部整理文档：不入库，防误提交。
# EN: Local promotion/reporting material and internal working docs: never commit.
promotion/
docs/PROJECT_TIMELINE.md
docs/HouyiDB_产品全景报告.pptx
docs/ARCHITECTURE.md
docs/ARCHITECTURE.pdf
docs/architecture/
docs/DEMO.md
