{
  "name": "houyidb",
  "version": "0.2.0-beta.8",
  "description": "Official TypeScript/JavaScript client for HouyiDB vector database",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houyidb-community/houyidb.git"
  },
  "homepage": "https://github.com/houyidb-community/houyidb",
  "bugs": {
    "url": "https://github.com/houyidb-community/houyidb/issues"
  }
